<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for Android 16+ promoted (Live Update) notifications, e.g. the progress-centric
         template. Non-runtime permission; ignored on older OS versions. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application>
        <receiver
            android:name="com.clevertap.android.pushtemplates.PTPushNotificationReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name="com.clevertap.android.pushtemplates.PushTemplateReceiver"
            android:enabled="true"
            android:exported="false" />
    </application>
</manifest>