<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed five icons for a campaign that sets pt_title or pt_msg. The strip is shorter than
     the expanded one so the text and the icons both fit the collapsed view; where that view is
     only 48dp the strip is hidden altogether, see FiveIconSmallContentView. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content_view_big"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <include
        android:id="@+id/five_cta_text_row"
        layout="@layout/content_view_small_single_line_msg" />

    <include
        android:id="@+id/five_cta_icon_row"
        layout="@layout/five_cta_icon_row"
        android:layout_width="match_parent"
        android:layout_height="@dimen/five_cta_icon_row_with_text" />
</LinearLayout>
